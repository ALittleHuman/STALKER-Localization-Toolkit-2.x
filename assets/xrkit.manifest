<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- xrkit GUI/build-gui/plugin-manager manifest: longPathAware only.
     activeCodePage=UTF-8 is deliberately NOT set here: xrkit_app.exe crashes at startup
     (0xC0000005) with it. Root cause TBD; CLI uses assets/xrkit_cli.manifest instead. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="xrkit.app" version="2.0.0.0" processorArchitecture="amd64"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
