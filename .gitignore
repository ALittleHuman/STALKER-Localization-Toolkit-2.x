# ── 构建产物（CMake / Ninja / MSBuild） ──────────────────────────────
/build/
/build-*/
/out/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
*.obj
*.o
*.pdb
*.idb
*.ilk

# ── 可执行与库产物（源码树里不该有） ─────────────────────────────────
*.exe
*.dll
*.lib
*.exp
*.pyd

# ── Qt 生成物 ────────────────────────────────────────────────────────
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_autogen/
*.qmlc

# ── IDE ─────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo

# ── 运行时产物 ───────────────────────────────────────────────────────
/logs/
/temp/
/dist/

# ── Python 缓存（生成器与门禁脚本都是 Python）────────────────────────
__pycache__/
*.pyc

# ── 第三方依赖源码：由 tools/fetch_third_party.py 拉取并校验 sha256 ──
# 源码体积大不入库；**锁文件与说明必须入库**（可复现的依据）
/third_party/*
!/third_party/SOURCES.md
!/third_party/sources.lock.json
!/third_party/CMakeLists.txt

# 构建版本存储的备份（运行期产物，不入库）
/version.json.bak
/dist/build_pkg_*.log
